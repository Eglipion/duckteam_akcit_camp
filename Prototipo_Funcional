                          type="text"
                          value={item.atividade}
                          onChange={(e) => updateItem(item.id, 'atividade', e.target.value)}
                          className={`w-full bg-transparent border-b border-transparent focus:border-indigo-500 focus:outline-none text-sm font-medium ${
                            isConcluido ? 'line-through text-slate-500' : 'text-slate-100'
                          }`}
                        />
                      </td>

                      {/* Duração Prevista */}
                      <td className="py-3.5 px-4 text-center">
                        <input
                          type="number"
                          min={5}
                          max={360}
                          step={5}
                          disabled={isConcluido}
                          value={item.duracaoPrevista}
                          onChange={(e) =>
                            updateItem(item.id, 'duracaoPrevista', Math.max(1, Number(e.target.value)))
                          }
                          className="w-16 text-center font-mono text-xs bg-slate-950 border border-slate-800 rounded-lg py-1 text-white focus:outline-none focus:border-indigo-500 disabled:opacity-40"
                        />
                      </td>

                      {/* Duração Mínima */}
                      <td className="py-3.5 px-4 text-center">
                        <input
                          type="number"
                          min={0}
                          max={item.duracaoPrevista}
                          step={5}
                          disabled={isConcluido}
                          value={item.duracaoMinima}
                          onChange={(e) =>
                            updateItem(item.id, 'duracaoMinima', Math.max(0, Number(e.target.value)))
                          }
                          className="w-16 text-center font-mono text-xs bg-slate-950 border border-slate-800 rounded-lg py-1 text-slate-300 focus:outline-none focus:border-indigo-500 disabled:opacity-40"
                        />
                      </td>

                      {/* Folga Disponível */}
                      <td className="py-3.5 px-4 text-center font-mono text-xs">
                        {item.status === 'pendente' ? (
                          <span
                            className={`px-2 py-0.5 rounded ${
                              item.folga > 0
                                ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                                : 'bg-slate-800 text-slate-500'
                            }`}
                          >
                            {item.folga} min
                          </span>
                        ) : (
                          <span className="text-slate-600">—</span>
                        )}
                      </td>

                      {/* Seletor de Peso 1 a 5 */}
                      <td className="py-3.5 px-4">
                        <div className="flex items-center gap-1">
                          {[1, 2, 3, 4, 5].map((nivel) => {
                            const ativo = item.peso >= nivel;
                            return (
                              <button
                                key={nivel}
                                disabled={isConcluido}
                                onClick={() => updateItem(item.id, 'peso', nivel)}
                                className={`w-6 h-6 rounded text-xs font-mono font-bold transition flex items-center justify-center cursor-pointer ${
                                  ativo
                                    ? item.peso === 5
                                      ? 'bg-indigo-500 text-white shadow-sm shadow-indigo-500/40'
                                      : 'bg-slate-700 text-slate-100'
                                    : 'bg-slate-950 text-slate-600 border border-slate-800'
                                } disabled:opacity-40`}
                                title={`Definir Peso ${nivel}`}
                              >
                                {nivel}
                              </button>
                            );
                          })}
                          {item.peso === 5 && (
                            <span className="ml-1.5 text-[10px] uppercase tracking-wider font-semibold text-indigo-400 flex items-center gap-0.5">
                              <Lock className="w-3 h-3" /> Crítico
                            </span>
                          )}
                        </div>
                      </td>

                      {/* Coluna Dinâmica Pós-IA */}
                      {aiResult && (
                        <td className="py-3.5 px-4 text-center font-mono text-xs whitespace-nowrap">
                          {ajusteIA ? (
                            ajusteIA.corte_min > 0 ? (
                              <span className="text-amber-300 font-bold bg-amber-500/15 border border-amber-500/30 px-2 py-1 rounded">
                                {ajusteIA.nova_duracao_min}m (-{ajusteIA.corte_min}m)
                              </span>
                            ) : (
                              <span className="text-emerald-400 font-medium">
                                {ajusteIA.nova_duracao_min}m (Intacto)
                              </span>
                            )
                          ) : (
                            <span className="text-slate-600">—</span>
                          )}
                        </td>
                      )}

                      {/* Remover Item */}
                      <td className="py-3.5 px-4 text-right">
                        <button
                          onClick={() => removeItem(item.id)}
                          className="p-1.5 rounded-lg text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 transition"
                          title="Remover bloco"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  );
}
