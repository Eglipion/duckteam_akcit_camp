// ==========================================
// UTILITÁRIOS DE TEMPO
// ==========================================
function timeToMinutes(timeStr) {
  const [h, m] = (timeStr || '09:00').split(':').map(Number);
  return h * 60 + m;
}

function minutesToTime(totalMinutes) {
  const normalized = ((totalMinutes % 1440) + 1440) % 1440;
  const h = Math.floor(normalized / 60);
  const m = Math.floor(normalized % 60);
  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
}

export default function App() {
  // Estado Principal do Evento
  const [selectedPreset, setSelectedPreset] = useState('hackathon');
  const [horarioInicio, setHorarioInicio] = useState(EVENT_PRESETS.hackathon.horarioInicio);
  const [regrasCulturais, setRegrasCulturais] = useState(EVENT_PRESETS.hackathon.regrasCulturais);
  const [cronograma, setCronograma] = useState(EVENT_PRESETS.hackathon.cronograma);

  // Estado do Simulador de Atraso
  const [atrasoMinutos, setAtrasoMinutos] = useState(35);
  const [motivoAtraso, setMotivoAtraso] = useState('Atraso na liberação do som do palco e fila no credenciamento');

  // Estado do Agente de IA & Resultados
  const [isCalculating, setIsCalculating] = useState(false);
  const [aiResult, setAiResult] = useState(null);
  const [showJsonModal, setShowJsonModal] = useState(false);
  const [novaAtividadeTexto, setNovaAtividadeTexto] = useState('');

  // Trocar Preset de Evento
  const handleSelectPreset = (presetKey) => {
    const preset = EVENT_PRESETS[presetKey];
    setSelectedPreset(presetKey);
    setHorarioInicio(preset.horarioInicio);
    setRegrasCulturais(preset.regrasCulturais);
    setCronograma(preset.cronograma.map(item => ({ ...item })));
    setAiResult(null);
  };

  // Cálculos Matemáticos em Tempo Real (Motor Lógico Pré-IA)
  const metricas = useMemo(() => {
    let cursorOriginal = timeToMinutes(horarioInicio);
    let cursorComAtraso = timeToMinutes(horarioInicio);
    let atrasoInserido = false;

    const itensComHorario = cronograma.map((item) => {
      const inicioOriginal = minutesToTime(cursorOriginal);
      const fimOriginal = minutesToTime(cursorOriginal + item.duracaoPrevista);
      cursorOriginal += item.duracaoPrevista;

      // O atraso passa a impactar a partir do item 'em_andamento' ou primeiro 'pendente'
      if (!atrasoInserido && (item.status === 'em_andamento' || item.status === 'pendente')) {
        cursorComAtraso += atrasoMinutos;
        atrasoInserido = true;
      }
      const inicioReal = minutesToTime(cursorComAtraso);
      const fimReal = minutesToTime(cursorComAtraso + item.duracaoPrevista);
      cursorComAtraso += item.duracaoPrevista;

      const folgaTotalItem = Math.max(0, item.duracaoPrevista - item.duracaoMinima);

      return {
        ...item,
        inicioOriginal,
        fimOriginal,
        inicioReal,
        fimReal,
        folga: item.status === 'pendente' ? folgaTotalItem : 0
      };
    });

    const pendentes = itensComHorario.filter((i) => i.status === 'pendente');
    const folgaTotalPendentes = pendentes.reduce((acc, cur) => acc + cur.folga, 0);
    const folgaSemPeso5 = pendentes
      .filter((i) => i.peso < 5)
      .reduce((acc, cur) => acc + cur.folga, 0);

    const duracaoTotalPrevista = cronograma.reduce((acc, cur) => acc + cur.duracaoPrevista, 0);
    const horarioEncerramentoPrevisto = minutesToTime(timeToMinutes(horarioInicio) + duracaoTotalPrevista);
    const horarioEncerramentoProjetadoSemAcao = minutesToTime(
      timeToMinutes(horarioInicio) + duracaoTotalPrevista + atrasoMinutos
    );

    const deficitInabsorvivel = Math.max(0, atrasoMinutos - folgaTotalPendentes);
    const precisaTocarPeso5 = atrasoMinutos > folgaSemPeso5;

    return {
      itensComHorario,
      folgaTotalPendentes,
      folgaSemPeso5,
      duracaoTotalPrevista,
      horarioEncerramentoPrevisto,
      horarioEncerramentoProjetadoSemAcao,
      deficitInabsorvivel,
      precisaTocarPeso5
    };
  }, [cronograma, horarioInicio, atrasoMinutos]);

  // Manipuladores de Edição da Tabela
  const updateItem = (id, field, value) => {
    setCronograma((prev) =>
      prev.map((item) => {
        if (item.id !== id) return item;
        const updated = { ...item, [field]: value };
        if (field === 'duracaoPrevista' && updated.duracaoMinima > value) {
          updated.duracaoMinima = value;
        }
        if (field === 'duracaoMinima' && value > updated.duracaoPrevista) {
          updated.duracaoMinima = updated.duracaoPrevista;
        }
        return updated;
      })
    );
    setAiResult(null);
  };

  const removeItem = (id) => {
    setCronograma((prev) => prev.filter((item) => item.id !== id));
    setAiResult(null);
  };

  const addItem = (e) => {
    e.preventDefault();
    if (!novaAtividadeTexto.trim()) return;
    const novoId = cronograma.length > 0 ? Math.max(...cronograma.map((i) => i.id)) + 1 : 1;
    setCronograma((prev) => [
      ...prev,
      {
        id: novoId,
        atividade: novaAtividadeTexto.trim(),
        duracaoPrevista: 30,
        duracaoMinima: 15,
        peso: 3,
        status: 'pendente'
      }
    ]);
    setNovaAtividadeTexto('');
    setAiResult(null);
  };

  // ==========================================
  // ALGORITMO MATEMÁTICO HÍBRIDO (FALLBACK E VALIDAÇÃO)
  // ==========================================
  const gerarPlanoDeterministico = () => {
    let restanteParaCortar = atrasoMinutos;
    const cortesPorId = {};

    // Ordena atividades pendentes por menor peso primeiro (1 -> 5) e maior folga
    const pendentesOrdenados = [...cronograma]
      .filter((i) => i.status === 'pendente')
      .sort((a, b) => a.peso - b.peso || (b.duracaoPrevista - b.duracaoMinima) - (a.duracaoPrevista - a.duracaoMinima));

    pendentesOrdenados.forEach((item) => {
      const folgaMax = Math.max(0, item.duracaoPrevista - item.duracaoMinima);
      if (restanteParaCortar > 0 && folgaMax > 0) {
        const corte = Math.min(restanteParaCortar, folgaMax);
        cortesPorId[item.id] = corte;
        restanteParaCortar -= corte;
      } else {
        cortesPorId[item.id] = 0;
      }
    });

    const ajustes = cronograma
      .filter((i) => i.status === 'pendente')
      .map((item) => {
        const corte = cortesPorId[item.id] || 0;
        const novaDuracao = item.duracaoPrevista - corte;
        let acaoTatica = 'Manter duração original intacta (bloco prioritário protegido).';

        if (corte > 0) {
          const nomeLower = item.atividade.toLowerCase();
          if (nomeLower.includes('coffee') || nomeLower.includes('almoço') || nomeLower.includes('pausa')) {
            acaoTatica = `Comprimir intervalo em ${corte} min. Converter para serviço contínuo ("grab-and-go") e avisar no microfone 5 min antes do retorno.`;
          } else if (nomeLower.includes('louvor') || nomeLower.includes('música')) {
            acaoTatica = `Reduzir ${corte} min do bloco musical (remover ${corte >= 10 ? '2 músicas' : '1 música'} do repertório e fazer transição direta).`;
          } else if (nomeLower.includes('avisos') || nomeLower.includes('sorteio') || nomeLower.includes('abertura')) {
            acaoTatica = `Corte rápido de ${corte} min: exibir informações via QR Code no telão principal e ir direto ao ponto central.`;
          } else if (nomeLower.includes('q&a') || nomeLower.includes('perguntas')) {
            acaoTatica = `Reduzir ${corte} min da sessão de perguntas no microfone; direcionar dúvidas para resposta online pós-evento.`;
          } else {
            acaoTatica = `Sinalizar ao responsável no palco que o bloco terá ${novaDuracao} min (redução de ${corte} min) com cronômetro regressivo ativo.`;
          }
        }

        return {
          id: item.id,
          nova_duracao_min: novaDuracao,
          corte_min: corte,
          acao_tatica: acaoTatica
        };
      });

    const totalCortado = Object.values(cortesPorId).reduce((a, b) => a + b, 0);
    const sobraAtraso = Math.max(0, atrasoMinutos - totalCortado);

    return {
      resumo_estrategia:
        sobraAtraso === 0
          ? `Absorvemos 100% dos ${atrasoMinutos} minutos de atraso comprimindo blocos de menor peso (pesos 1 a 3) e preservando integralmente o núcleo principal do evento.`
          : `Foram absorvidos ${totalCortado} min (limite físico máximo sem violar durações mínimas). O evento encerrará com ${sobraAtraso} min de estouro em relação ao horário original.`,
      alerta_estouro:
        sobraAtraso > 0
          ? `Atenção: O atraso (${atrasoMinutos}m) supera a folga elástica total disponível nas atividades pendentes (${totalCortado}m). Restam ${sobraAtraso}m que estourarão o horário final.`
          : '',
      ajustes,
      origem: 'Motor Híbrido'
    };
  };

  // ==========================================
  // INTEGRAÇÃO COM A API GEMINI (STAGE MANAGER AGENT)
  // ==========================================
  const acionarAgenteIA = async () => {
    setIsCalculating(true);
    setAiResult(null);

    const systemPrompt = `Você é um Diretor de Palco (Stage Manager) e Especialista Sênior em Logística de Eventos em Tempo Real.
Sua missão é receber o cronograma de um evento que sofreu um atraso de ${atrasoMinutos} minutos e redistribuir os cortes de tempo apenas nas atividades com status "pendente".

REGRAS INEGOCIÁVEIS:
1. NUNCA reduza uma atividade abaixo de sua "duracaoMinima".
2. O corte máximo de um item é (duracaoPrevista - duracaoMinima).
3. Priorize cortar itens de Peso 1, 2 e 3. Itens de Peso 4 só devem ser cortados se necessário. Itens de Peso 5 são sagrados e SÓ podem sofrer corte se todas as outras folgas já tiverem sido esgotadas.
4. A soma de "corte_min" de todas as atividades pendentes deve tentar igualar exatamente ${atrasoMinutos} minutos (ou o máximo possível se a folga total for menor que o atraso).
5. Use as "Regras Culturais do Evento" e o "Motivo do Atraso" para criar recomendações práticas, realistas e diretas de palco no campo "acao_tatica" em português (pt-BR).`;

    const payloadContext = {
      perfil_evento: EVENT_PRESETS[selectedPreset]?.nome || 'Evento Personalizado',
      regras_culturais: regrasCulturais,
      atraso_acumulado_minutos: atrasoMinutos,
      motivo_do_atraso: motivoAtraso,
      folga_total_disponivel_pendentes: metricas.folgaTotalPendentes,
      atividades_pendentes: cronograma
        .filter((i) => i.status === 'pendente')
        .map((i) => ({
          id: i.id,
          atividade: i.atividade,
          duracaoPrevista: i.duracaoPrevista,
          duracaoMinima: i.duracaoMinima,
          folgaMaximaCortavel: i.duracaoPrevista - i.duracaoMinima,
          pesoImportancia: i.peso
        }))
    };

    const apiKey = '';
    const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

    const payload = {
      contents: [
        {
          role: 'user',
          parts: [
            {
              text: `Calcule o plano de recuperação de cronograma para o seguinte cenário em JSON:\n${JSON.stringify(
                payloadContext,
                null,
                2
              )}`
            }
          ]
        }
      ],
      systemInstruction: {
        parts: [{ text: systemPrompt }]
      },
      generationConfig: {
        responseMimeType: 'application/json',
        responseSchema: {
          type: 'OBJECT',
          properties: {
            resumo_estrategia: { type: 'STRING' },
            alerta_estouro: { type: 'STRING' },
            ajustes: {
              type: 'ARRAY',
              items: {
                type: 'OBJECT',
                properties: {
                  id: { type: 'INTEGER' },
                  nova_duracao_min: { type: 'INTEGER' },
                  corte_min: { type: 'INTEGER' },
                  acao_tatica: { type: 'STRING' }
                },
                propertyOrdering: ['id', 'nova_duracao_min', 'corte_min', 'acao_tatica']
              }
            }
          },
          propertyOrdering: ['resumo_estrategia', 'alerta_estouro', 'ajustes']
        }
      }
    };

    // Função de chamada com Exponential Backoff
    const fetchWithRetry = async (retries = 3, delay = 1000) => {
      for (let attempt = 0; attempt < retries; attempt++) {
        try {
          const res = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (!res.ok) throw new Error(`HTTP status ${res.status}`);
          const data = await res.json();
          const text = data?.candidates?.[0]?.content?.parts?.[0]?.text;
          if (text) {
            return JSON.parse(text);
          }
          throw new Error('Resposta sem conteúdo JSON válido');
        } catch (err) {
          if (attempt === retries - 1) throw err;
          await new Promise((r) => setTimeout(r, delay * Math.pow(2, attempt)));
        }
      }
    };

    try {
      const parsed = await fetchWithRetry(2, 800);
      // Garantir consistência matemática nos limites mínimos caso o LLM erre algum cálculo
      const ajustesNormalizados = cronograma
        .filter((i) => i.status === 'pendente')
        .map((item) => {
          const found = parsed.ajustes?.find((a) => Number(a.id) === Number(item.id));
          if (!found) {
            return {
              id: item.id,
              nova_duracao_min: item.duracaoPrevista,
              corte_min: 0,
              acao_tatica: 'Manter conforme previsto.'
            };
          }
          const maxCorte = Math.max(0, item.duracaoPrevista - item.duracaoMinima);
          const corteSeguro = Math.min(maxCorte, Math.max(0, Number(found.corte_min) || 0));
          return {
            id: item.id,
            nova_duracao_min: item.duracaoPrevista - corteSeguro,
            corte_min: corteSeguro,
            acao_tatica: found.acao_tatica || 'Ajuste de tempo aplicado.'
          };
        });

      setAiResult({
        resumo_estrategia: parsed.resumo_estrategia,
        alerta_estouro: parsed.alerta_estouro || '',
        ajustes: ajustesNormalizados,
        origem: 'Gemini 3 Flash (Stage Manager AI)'
      });
    } catch (error) {
      // Fallback determinístico inteligente se a API falhar
      const fallbackPlan = gerarPlanoDeterministico();
      setAiResult(fallbackPlan);
    } finally {
      setIsCalculating(false);
    }
  };

  // Aplicar os ajustes sugeridos pela IA na tabela principal
  const aplicarNovoCronograma = () => {
    if (!aiResult) return;
    setCronograma((prev) =>
      prev.map((item) => {
        const ajuste = aiResult.ajustes.find((a) => Number(a.id) === Number(item.id));
        if (ajuste && item.status === 'pendente') {
          return {
            ...item,
            duracaoPrevista: ajuste.nova_duracao_min
          };
        }
        return item;
      })
    );
    const totalCortado = aiResult.ajustes.reduce((acc, cur) => acc + (cur.corte_min || 0), 0);
    setAtrasoMinutos((prev) => Math.max(0, prev - totalCortado));
    setAiResult(null);
  };

  // Renderizador de Ícone do Preset
  const renderPresetIcon = (iconName, className = 'w-4 h-4') => {
    switch (iconName) {
      case 'Code2':
        return <Code2 className={className} />;
      case 'Church':
        return <Church className={className} />;
      case 'Briefcase':
        return <Briefcase className={className} />;
      default:
        return <Sparkles className={className} />;
    }
  };

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 font-sans selection:bg-indigo-500/30 selection:text-indigo-200 pb-16">
      {/* HEADER BAR */}
      <header className="border-b border-slate-800/80 bg-slate-950/90 backdrop-blur-md sticky top-0 z-30">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 shadow-inner">
              <Cpu className="w-5 h-5" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <h1 className="text-lg font-bold tracking-tight text-white">StageManager AI</h1>
                <span className="text-[11px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  Protótipo Híbrido
                </span>
              </div>
              <p className="text-xs text-slate-400">
                Agente Inteligente de Adaptação e Rebalanceamento de Cronograma em Tempo Real
              </p>
            </div>
          </div>

